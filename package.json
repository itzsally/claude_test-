{
  "name": "the-reading-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Reading Room \u2014 a calm, editorial digital library for discovering books.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "vite build --mode artifact && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.0"
  }
}
