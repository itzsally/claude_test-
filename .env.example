# Copy this file to ".env" and fill in your keys.
#   cp .env.example .env
# The .env file is git-ignored, so your keys stay on your machine.

# ---- REQUIRED ---------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- OPTIONAL but recommended: Reddit ---------------------------------------
# Create an app at https://www.reddit.com/prefs/apps  ("create another app...")
#   - type: script
#   - redirect uri: http://localhost:8080   (unused, but the form requires one)
# Then copy the id shown under the app name, and the "secret" field.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks that you identify your app. Put your own Reddit username here.
REDDIT_USER_AGENT=python:two-agent-research:0.1 (by /u/your_username)

# ---- OPTIONAL tuning --------------------------------------------------------
# Both agents default to claude-opus-5. To spend less, try claude-sonnet-5
# for the scout (it does many turns) and keep opus for the write-up.
# SCOUT_MODEL=claude-sonnet-5
# EDITOR_MODEL=claude-opus-5

# How hard the models think: low | medium | high | xhigh | max
# EFFORT=high

# How many research turns the scout may take before it must hand over.
# MAX_TURNS=14
